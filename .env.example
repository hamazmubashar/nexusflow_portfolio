# Copy to .env and fill in. Never commit .env.

# --- Gemini (google-genai SDK) ---
GEMINI_API_KEY=your-gemini-api-key-here

# --- PostgreSQL (docker-compose) ---
POSTGRES_USER=nexusflow
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=nexusflow
POSTGRES_PORT=5432
N8N_DB_NAME=n8n

# Used by the FastAPI backend and the ingestion script (host -> container)
DATABASE_URL=postgresql+psycopg2://nexusflow:change-me-local-only@localhost:5432/nexusflow

# --- n8n ---
# Host port for the n8n editor; change if 5678 is already taken on this machine
N8N_HOST_PORT=5678
# Generate with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=replace-with-openssl-rand-hex-32
N8N_WEBHOOK_URL=http://localhost:5678/webhook

# --- RAG (Stage 2) ---
# gemini (default) or local (offline fastembed BAAI/bge-base-en-v1.5; pip install fastembed)
EMBEDDING_PROVIDER=gemini
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_CHAT_MODEL=gemini-3.5-flash
GEMINI_CHAT_FALLBACK_MODELS=gemini-3.8-flash,gemini-flash-latest
# langchain (LCEL chain, default) or native (hand-written loop); identical prompt, schema and verification
COPILOT_ENGINE=langchain

# --- Webhooks (Stage 3) ---
# Shared HMAC-SHA256 secret for FastAPI <-> n8n. Generate with: openssl rand -hex 32
WEBHOOK_SIGNING_SECRET=replace-with-openssl-rand-hex-32
# Max age of a signed request before it is rejected as a replay
WEBHOOK_TOLERANCE_SECONDS=300
# live | mock | auto (auto = live, but queue + mock-ack when n8n is unreachable)
N8N_DISPATCH_MODE=auto
# How n8n (inside Docker) reaches the FastAPI backend on the host
NEXUSFLOW_API_BASE_URL=http://host.docker.internal:8010
# Optional: Slack/Discord incoming-webhook URL for P1 alerts (empty = format only, no post)
NEXUSFLOW_ALERT_WEBHOOK_URL=
NEXUSFLOW_ALERT_FORMAT=slack

# --- Governance agent / HITL (Stage 4) ---
# Key for signed approval tokens (openssl rand -hex 32). Empty = derived from WEBHOOK_SIGNING_SECRET.
APPROVAL_TOKEN_SECRET=
APPROVAL_TOKEN_TTL_HOURS=72
# Base URL put in approval callback links
API_PUBLIC_BASE_URL=http://localhost:8010
GOVERNANCE_APPROVER_ROLE=Finance Director

# --- API hardening (Stage 5) ---
ENVIRONMENT=development
LOG_FORMAT=json
LOG_LEVEL=INFO
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173
# HS256 key for user JWTs (openssl rand -hex 32). Empty = derived from WEBHOOK_SIGNING_SECRET.
JWT_SECRET=
JWT_TTL_MINUTES=480
HEALTH_CACHE_SECONDS=60
